{{!
    @template block_smooth_dashboard/courses

    Course cards: progress, what is left to do (first activities in course order), Zoom
    attendance and leaderboard place. The most recently visited course comes first. When not
    every course in progress has a card, the link says how many there are.

    Example context (json):
    {
        "uniqid": "smooth-dashboard-1",
        "hascourses": true, "morecourses": true, "coursestotal": 9, "mycoursesurl": "#",
        "courses": [{"id": 2, "name": "Physics 101", "url": "#", "image": "#", "hasprogress": true, "progress": 40,
            "done": false, "todotext": "5 to do", "hastodo": true, "todomore": 2, "continueurl": "#",
            "todo": [{"name": "Quiz 3", "url": "#", "iconurl": "#", "modtype": "Quiz", "failed": false}],
            "attendance": {"text": "92% attendance", "level": "good", "url": "#", "low": false},
            "rank": {"text": "#2 of 48", "url": "#"}, "hasmeta": true}]
    }
}}
<section class="sd-section" aria-labelledby="{{uniqid}}-courses">
    <div class="sd-section-head">
        <h4 class="sd-section-title" id="{{uniqid}}-courses">{{#str}}mycourses, block_smooth_dashboard{{/str}}</h4>
        <a class="sd-link" href="{{mycoursesurl}}">
            {{#morecourses}}{{#str}}allcoursescount, block_smooth_dashboard, {{coursestotal}}{{/str}}{{/morecourses}}
            {{^morecourses}}{{#str}}allcourses, block_smooth_dashboard{{/str}}{{/morecourses}}
        </a>
    </div>
    {{#hascourses}}
    <div class="sd-courses">
        {{#courses}}
        <article class="sd-course">
            <a class="sd-course-banner" href="{{url}}" tabindex="-1" aria-hidden="true">
                <img src="{{image}}" alt="" loading="lazy">
            </a>
            <div class="sd-course-body">
                <h5 class="sd-course-name"><a href="{{url}}">{{{name}}}</a></h5>

                {{#hasprogress}}
                <div class="sd-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{progress}}"
                        aria-label="{{#str}}progress, block_smooth_dashboard{{/str}}">
                    <div class="sd-progress-bar{{#done}} is-done{{/done}}" style="width: {{progress}}%;"></div>
                </div>
                <div class="sd-progress-text">{{#str}}percentcomplete, block_smooth_dashboard, {{progress}}{{/str}}</div>
                {{/hasprogress}}

                {{#hasmeta}}
                <div class="sd-meta">
                    {{#todotext}}<span class="sd-pill sd-pill-todo">{{todotext}}</span>{{/todotext}}
                    {{#done}}<span class="sd-pill sd-pill-done">{{#str}}alldone, block_smooth_dashboard{{/str}}</span>{{/done}}
                    {{#attendance}}<a class="sd-pill sd-pill-att is-{{level}}" href="{{url}}">{{text}}{{#low}} · {{#str}}low, block_smooth_dashboard{{/str}}{{/low}}</a>{{/attendance}}
                    {{#rank}}<a class="sd-pill sd-pill-rank" href="{{url}}">{{text}}</a>{{/rank}}
                </div>
                {{/hasmeta}}

                {{#hastodo}}
                <div class="sd-todo">
                    <div class="sd-todo-title">{{#str}}upnext, block_smooth_dashboard{{/str}}</div>
                    <ul class="sd-todo-list">
                        {{#todo}}
                        <li>
                            <img class="sd-todo-icon" src="{{iconurl}}" alt="{{modtype}}" title="{{modtype}}">
                            <a href="{{url}}">{{{name}}}</a>
                            {{#failed}}<span class="sd-status sd-status-overdue">{{#str}}tryagain, block_smooth_dashboard{{/str}}</span>{{/failed}}
                        </li>
                        {{/todo}}
                    </ul>
                    {{#todomore}}<a class="sd-more" href="{{url}}">{{#str}}andmore, block_smooth_dashboard, {{todomore}}{{/str}}</a>{{/todomore}}
                </div>
                {{/hastodo}}

                <a class="sd-btn sd-btn-soft" href="{{continueurl}}">
                    {{#hastodo}}{{#str}}continue, block_smooth_dashboard{{/str}}{{/hastodo}}{{^hastodo}}{{#str}}opencourse, block_smooth_dashboard{{/str}}{{/hastodo}}
                    <svg class="sd-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
            </div>
        </article>
        {{/courses}}
    </div>
    {{/hascourses}}
    {{^hascourses}}
    <p class="sd-empty">{{#str}}nocourses, block_smooth_dashboard{{/str}}</p>
    {{/hascourses}}
</section>
