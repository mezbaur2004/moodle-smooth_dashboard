{{!
    @template block_smooth_dashboard/rankings

    Leaderboards: per course, the top 3 and the user's own place. Names and anonymous labels
    come from mod_leaderboard (plain text). Ranks are printed, because students with the same
    points share a rank.

    Example context (json):
    {
        "uniqid": "smooth-dashboard-1",
        "rankings": [{"course": "Physics 101", "url": "#", "metext": "You: #5 of 48 · 120 pts",
            "meoutside": true, "rows": [{"rank": 1, "medal": 1, "name": "Rahim Uddin", "points": "240", "isme": false}]}]
    }
}}
<section class="sd-section" aria-labelledby="{{uniqid}}-rankings">
    <div class="sd-section-head">
        <h4 class="sd-section-title" id="{{uniqid}}-rankings">{{#str}}leaderboards, block_smooth_dashboard{{/str}}</h4>
    </div>
    <div class="sd-boards">
        {{#rankings}}
        <article class="sd-card sd-board">
            <div class="sd-card-head">
                <h5 class="sd-board-course">{{{course}}}</h5>
                <a class="sd-link" href="{{url}}">{{#str}}viewall, block_smooth_dashboard{{/str}}</a>
            </div>
            <ol class="sd-podium">
                {{#rows}}
                <li class="sd-rank{{#isme}} is-me{{/isme}}">
                    <span class="sd-medal sd-medal-{{medal}}">{{rank}}</span>
                    <span class="sd-rank-name">{{name}}</span>
                    <span class="sd-rank-points">{{#str}}points, block_smooth_dashboard, {{points}}{{/str}}</span>
                </li>
                {{/rows}}
            </ol>
            {{#meoutside}}<div class="sd-you">{{metext}}</div>{{/meoutside}}
        </article>
        {{/rankings}}
    </div>
</section>
